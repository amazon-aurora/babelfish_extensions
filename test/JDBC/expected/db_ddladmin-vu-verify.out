-- tsql database=babel_5116_db
/********** DDLADMIN SHOULD NOT BE A DEPENDANT OF ANY OBJECT WE CREATED IN THIS TEST **********/
SELECT CAST(r.rolname AS CHAR(30)), CAST(object_name(objid) AS char(30)), deptype FROM pg_depend d
    JOIN pg_roles r ON (d.refobjid = r.oid)
    WHERE
        object_name(objid) LIKE 'babel_5116%' AND
        refclassid = (SELECT oid FROM pg_class WHERE relname = 'pg_authid')
    ORDER BY deptype, r.rolname, objid;
GO
~~START~~
char#!#char#!#varchar
~~END~~


SELECT CAST(r.rolname AS CHAR(30)), CAST(object_name(objid) AS char(30)), deptype FROM pg_shdepend d

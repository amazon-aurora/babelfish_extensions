/********** OBJECT OWNER SHOULD BE SCHEMA OWNER WHEN OBJECT IS CREATED BY DDLADMIN **********/
SELECT relname, r.rolname
    FROM pg_class c
    JOIN pg_roles r ON (c.relowner = r.oid)
    WHERE relname LIKE 'babel_5116%'
    ORDER BY r.rolname, relname;
GO

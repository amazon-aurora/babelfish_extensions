-- =====================================================
-- Test Case 1: GUC mismatch detection (multi-db to single-db)
-- =====================================================

-- tsql
USE master;
GO

CREATE DATABASE multi_db_test;
GO

-- terminate-tsql-conn

-- psql
ALTER SYSTEM SET babelfishpg_tsql.migration_mode = 'single-db';
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
-- should fail
USE master;
GO

-- =====================================================
-- Test Case 2: Normal operation in multi-db mode
-- =====================================================
-- Now set up multi-db mode properly
-- psql
ALTER SYSTEM SET babelfishpg_tsql.migration_mode = 'multi-db';
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
USE master;
GO

DROP DATABASE multi_db_test;
GO

-- terminate-tsql-conn

-- =====================================================
-- Test Case 3: Normal operation in single-db mode
-- =====================================================
-- Now set up multi-db mode properly
-- psql
ALTER SYSTEM SET babelfishpg_tsql.migration_mode = 'single-db';
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
USE master;
GO

CREATE DATABASE single_db_test;
GO

-- terminate-tsql-conn

-- =====================================================
-- Test Case 4: GUC mismatch detection (single-db to multi-db)
-- =====================================================
-- psql
-- Change migration mode to multi-db
ALTER SYSTEM SET babelfishpg_tsql.migration_mode = 'multi-db';
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
-- should fail
USE master;
GO

-- psql
-- cleanup single-db database
ALTER SYSTEM SET babelfishpg_tsql.migration_mode = 'single-db';
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
USE master;
GO

DROP DATABASE single_db_test;
GO

-- terminate-tsql-conn

-- =====================================================
-- Test Case 5: Mixed pattern detection
-- =====================================================

-- psql
-- Enable bypass to create mixed patterns
ALTER SYSTEM SET babelfishpg_tsql.bypass_migration_mode_check = true;
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
USE master;
GO

-- Create a single-db database
USE master;
GO

CREATE DATABASE single_db_test;
GO

-- terminate-tsql-conn

-- Now switch to multi-db mode but keep bypass on
-- psql
ALTER SYSTEM SET babelfishpg_tsql.migration_mode = 'multi-db';
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
-- Should succeed because bypass is on
USE master;
GO

-- Create a new database with multi-db schema pattern
CREATE DATABASE multi_db_test;
GO

-- Verify we have both patterns
SELECT n.nspname, n.orig_name, d.name AS db_name
FROM sys.babelfish_namespace_ext n 
JOIN sys.babelfish_sysdatabases d ON n.dbid = d.dbid 
WHERE d.name IN ('multi_db_test', 'single_db_test') AND n.orig_name = 'dbo'
ORDER BY d.name, n.orig_name;
GO

-- terminate-tsql-conn

-- psql
-- Disable bypass and try to connect - should fail with inconsistent pattern error
ALTER SYSTEM SET babelfishpg_tsql.bypass_migration_mode_check = off;
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- tsql
-- should throw error
USE master;
GO

-- psql
ALTER SYSTEM SET babelfishpg_tsql.migration_mode = 'multi-db';
GO

SELECT pg_reload_conf();
GO

SELECT pg_sleep(1);
GO

-- psql
SHOW babelfishpg_tsql.migration_mode;
GO

-- terminate-psql-conn
go

create user babel_5690_user_1 for login babel_5690_login_1;
go

create user babel_5690_user_2 for login babel_5690_login_2;
go

create user babel_5690_user_3 for login babel_5690_login_3;
go

CREATE VIEW babel_5690_db_permissions_view AS
SELECT
    dp.class_desc,
    dp.major_id,
    sys.USER_NAME(dp.grantee_principal_id) AS grantee_name,
    sys.USER_NAME(dp.grantor_principal_id) AS grantor_name,
    dp.permission_name,
    dp.state_desc
FROM
    sys.database_permissions dp;
GO
GRANT SELECT ON dbo.babel_5690_db_permissions_view TO PUBLIC;
GO


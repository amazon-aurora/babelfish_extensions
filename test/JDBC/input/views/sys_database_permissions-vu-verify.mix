grant select on babel_5690_table_2 to babel_5690_user_4;
grant execute on babel_5690_function_2 to babel_5690_user_4;
go

-- Switching over to a new database, we can only view the permissions existing in that database
select * from dbo.babel_5690_db_permissions_view;
go

-- Revoke the permissions
revoke select on babel_5690_table_2 from babel_5690_user_4;
revoke execute on babel_5690_function_2 from babel_5690_user_4;
go


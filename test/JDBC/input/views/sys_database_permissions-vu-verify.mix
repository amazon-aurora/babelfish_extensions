-- Grant Permissions to public
grant select on babel_5690_table_1 to public;
grant execute on babel_5690_procedure_1 to public;
go

-- Grant Permissions to guest
grant select on babel_5690_table_1 to guest;
grant execute on babel_5690_procedure_1 to guest;
go

-- tsql user=babel_5690_login_2 password='123'
use babel_5690_db_1;
go

-- Permissions granted to public are visible to all the users, while permissions granted to guest are not
select * from dbo.babel_5690_db_permissions_view;
go

-- tsql
use babel_5690_db_1;
go

-- Revoke Permissions
revoke select on babel_5690_table_1 to public;
revoke execute on babel_5690_procedure_1 to public;
revoke select on babel_5690_table_1 to guest;
revoke execute on babel_5690_procedure_1 to guest;
go

select * from dbo.babel_5690_db_permissions_view;
go

